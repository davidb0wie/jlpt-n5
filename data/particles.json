{
  "particles": [
    {
      "particle": "は",
      "romaji": "wa",
      "description": "Marqueur de thème/sujet",
      "usage": "Indique le thème principal de la phrase",
      "example": "私は学生です。(Watashi wa gakusei desu. - Je suis étudiant.)"
    },
    {
      "particle": "が",
      "romaji": "ga",
      "description": "Marqueur de sujet grammatical",
      "usage": "Indique le sujet qui fait l'action, utilisé pour identifier/contraster",
      "example": "誰が来ますか。(Dare ga kimasu ka. - Qui vient ?)"
    },
    {
      "particle": "を",
      "romaji": "wo/o",
      "description": "Marqueur d'objet direct",
      "usage": "Indique l'objet direct d'une action",
      "example": "りんごを食べます。(Ringo wo tabemasu. - Je mange une pomme.)"
    },
    {
      "particle": "に",
      "romaji": "ni",
      "description": "Lieu, temps, direction, objet indirect",
      "usage": "Indique la destination, le temps, le lieu d'existence, l'objet indirect",
      "example": "学校に行きます。(Gakkou ni ikimasu. - Je vais à l'école.)"
    },
    {
      "particle": "で",
      "romaji": "de",
      "description": "Lieu d'action, moyen/méthode",
      "usage": "Indique où une action se déroule ou le moyen utilisé",
      "example": "図書館で勉強します。(Toshokan de benkyou shimasu. - J'étudie à la bibliothèque.)"
    },
    {
      "particle": "と",
      "romaji": "to",
      "description": "Et (liste exhaustive), avec, citation",
      "usage": "Relie des noms (liste complète), indique avec qui, ou marque une citation",
      "example": "友達と映画を見ます。(Tomodachi to eiga wo mimasu. - Je regarde un film avec un ami.)"
    },
    {
      "particle": "の",
      "romaji": "no",
      "description": "Possessif, modificateur de nom",
      "usage": "Indique la possession ou relie des noms",
      "example": "私の本です。(Watashi no hon desu. - C'est mon livre.)"
    },
    {
      "particle": "へ",
      "romaji": "e",
      "description": "Direction (vers)",
      "usage": "Indique la direction générale du mouvement",
      "example": "東京へ行きます。(Tokyo e ikimasu. - Je vais vers Tokyo.)"
    },
    {
      "particle": "か",
      "romaji": "ka",
      "description": "Marqueur de question",
      "usage": "Transforme une phrase en question",
      "example": "これは何ですか。(Kore wa nan desu ka. - Qu'est-ce que c'est ?)"
    },
    {
      "particle": "も",
      "romaji": "mo",
      "description": "Aussi, également",
      "usage": "Indique l'inclusion, remplace は ou が",
      "example": "私も学生です。(Watashi mo gakusei desu. - Je suis étudiant aussi.)"
    },
    {
      "particle": "や",
      "romaji": "ya",
      "description": "Et (liste non exhaustive)",
      "usage": "Relie des noms avec l'implication qu'il y en a d'autres",
      "example": "りんごやバナナを買いました。(Ringo ya banana wo kaimashita. - J'ai acheté des pommes, des bananes, etc.)"
    },
    {
      "particle": "から",
      "romaji": "kara",
      "description": "De (point de départ), parce que",
      "usage": "Indique le point de départ dans le temps/espace ou la raison",
      "example": "駅から来ました。(Eki kara kimashita. - Je viens de la gare.)"
    },
    {
      "particle": "まで",
      "romaji": "made",
      "description": "Jusqu'à",
      "usage": "Indique le point d'arrivée dans le temps ou l'espace",
      "example": "五時まで働きます。(Goji made hatarakimasu. - Je travaille jusqu'à 5 heures.)"
    },
    {
      "particle": "より",
      "romaji": "yori",
      "description": "Que (comparaison), de",
      "usage": "Utilisé pour les comparaisons",
      "example": "これはあれより大きいです。(Kore wa are yori ookii desu. - Ceci est plus grand que cela.)"
    }
  ],
