      "level": "N5",
      "explanation": "Exprime le désir de faire quelque chose (je veux...).",
      "structure": "[Radical ます] + たい",
      "examples": [
        {"japanese": "日本に行きたいです。", "romaji": "Nihon ni ikitai desu.", "french": "Je veux aller au Japon."},
        {"japanese": "寿司を食べたいです。", "romaji": "Sushi o tabetai desu.", "french": "Je veux manger des sushis."},
        {"japanese": "映画を見たいです。", "romaji": "Eiga o mitai desu.", "french": "Je veux voir un film."}
      ]
    },
    {
      "id": 27,
      "pattern": "〜たくない",
      "category": "verbes",
      "level": "N5",
      "explanation": "Exprime le désir de ne pas faire quelque chose (je ne veux pas...).",
      "structure": "[Radical ます] + たくない / たくないです",
      "examples": [
        {"japanese": "行きたくないです。", "romaji": "Ikitakunai desu.", "french": "Je ne veux pas y aller."},
        {"japanese": "食べたくないです。", "romaji": "Tabetakunai desu.", "french": "Je ne veux pas manger."},
        {"japanese": "勉強したくないです。", "romaji": "Benkyō shitakunai desu.", "french": "Je ne veux pas étudier."}
      ]
    },
    {
      "id": 28,
      "pattern": "〜ない形",
      "category": "verbes",
      "level": "N5",
      "explanation": "Forme négative neutre/dictionnaire des verbes.",
      "structure": "[Verbe] → [Forme ない]",
      "examples": [
        {"japanese": "食べない", "romaji": "tabenai", "french": "ne pas manger"},
        {"japanese": "行かない", "romaji": "ikanai", "french": "ne pas aller"},
        {"japanese": "しない", "romaji": "shinai", "french": "ne pas faire"}
      ]
    },
    {
      "id": 29,
      "pattern": "〜た形",
      "category": "verbes",
      "level": "N5",
      "explanation": "Forme passée neutre/dictionnaire des verbes.",
      "structure": "[Verbe forme て] → た/だ",
      "examples": [
        {"japanese": "食べた", "romaji": "tabeta", "french": "a mangé"},
        {"japanese": "行った", "romaji": "itta", "french": "est allé"},
        {"japanese": "読んだ", "romaji": "yonda", "french": "a lu"}
      ]
    },
    {
      "id": 30,
      "pattern": "〜ませんか",
      "category": "verbes",
      "level": "N5",
      "explanation": "Invitation polie (voulez-vous... ?).",
      "structure": "[Radical] + ませんか",
      "examples": [
