        {"japanese": "泳ぐことができます。", "romaji": "Oyogu koto ga dekimasu.", "french": "Je peux nager."},
        {"japanese": "車を運転することができます。", "romaji": "Kuruma o unten suru koto ga dekimasu.", "french": "Je peux conduire une voiture."}
      ]
    },
    {
      "id": 34,
      "pattern": "〜が欲しい",
      "category": "désir",
      "level": "N5",
      "explanation": "Exprime le désir de posséder quelque chose (je veux...).",
