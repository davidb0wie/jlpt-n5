      "pattern": "〜ましょう",
      "category": "verbes",
      "level": "N5",
      "explanation": "Proposition (faisons... / allons...).",
      "structure": "[Radical] + ましょう",
      "examples": [
        {"japanese": "一緒に行きましょう。", "romaji": "Issho ni ikimashō.", "french": "Allons-y ensemble."},
        {"japanese": "昼ご飯を食べましょう。", "romaji": "Hirugohan o tabemashō.", "french": "Mangeons le déjeuner."},
        {"japanese": "休みましょう。", "romaji": "Yasumimashō.", "french": "Reposons-nous."}
      ]
    },
    {
      "id": 32,
      "pattern": "〜ましょうか",
      "category": "verbes",
      "level": "N5",
      "explanation": "Offre d'aide ou suggestion (dois-je... ?).",
      "structure": "[Radical] + ましょうか",
      "examples": [
        {"japanese": "手伝いましょうか。", "romaji": "Tetsudaimashō ka.", "french": "Dois-je vous aider ?"},
