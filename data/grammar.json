{
  "grammar_points": [
    {
      "id": 1,
      "pattern": "〜は",
      "category": "particules",
      "level": "N5",
      "explanation": "Marque le thème/sujet de la phrase. Indique de quoi on parle.",
      "structure": "[Nom] + は + [reste de la phrase]",
      "examples": [
        {"japanese": "私は学生です。", "romaji": "Watashi wa gakusei desu.", "french": "Je suis étudiant(e)."},
        {"japanese": "これは本です。", "romaji": "Kore wa hon desu.", "french": "Ceci est un livre."},
        {"japanese": "日本は美しいです。", "romaji": "Nihon wa utsukushii desu.", "french": "Le Japon est beau."}
      ]
    },
    {
      "id": 2,
      "pattern": "〜が",
      "category": "particules",
      "level": "N5",
      "explanation": "Marque le sujet grammatical. Utilisé pour identifier quelque chose ou exprimer une préférence.",
      "structure": "[Nom] + が + [verbe/adjectif]",
      "examples": [
        {"japanese": "誰が来ますか。", "romaji": "Dare ga kimasu ka.", "french": "Qui vient ?"},
        {"japanese": "犬がいます。", "romaji": "Inu ga imasu.", "french": "Il y a un chien."},
        {"japanese": "コーヒーが好きです。", "romaji": "Kōhī ga suki desu.", "french": "J'aime le café."}
      ]
    },
    {
      "id": 3,
      "pattern": "〜を",
      "category": "particules",
      "level": "N5",
      "explanation": "Marque le complément d'objet direct (COD).",
      "structure": "[Nom] + を + [verbe transitif]",
      "examples": [
        {"japanese": "本を読みます。", "romaji": "Hon o yomimasu.", "french": "Je lis un livre."},
        {"japanese": "水を飲みます。", "romaji": "Mizu o nomimasu.", "french": "Je bois de l'eau."},
        {"japanese": "音楽を聞きます。", "romaji": "Ongaku o kikimasu.", "french": "J'écoute de la musique."}
      ]
    },
    {
      "id": 4,
      "pattern": "〜に (lieu)",
      "category": "particules",
      "level": "N5",
      "explanation": "Indique le lieu de destination ou d'existence.",
      "structure": "[Nom de lieu] + に + [verbe de mouvement/existence]",
      "examples": [
        {"japanese": "学校に行きます。", "romaji": "Gakkō ni ikimasu.", "french": "Je vais à l'école."},
        {"japanese": "東京に住んでいます。", "romaji": "Tōkyō ni sunde imasu.", "french": "J'habite à Tokyo."},
        {"japanese": "机の上に本があります。", "romaji": "Tsukue no ue ni hon ga arimasu.", "french": "Il y a un livre sur le bureau."}
      ]
    },
    {
      "id": 5,
      "pattern": "〜に (temps)",
      "category": "particules",
      "level": "N5",
      "explanation": "Indique le moment précis d'une action.",
      "structure": "[Expression de temps] + に + [verbe]",
      "examples": [
        {"japanese": "七時に起きます。", "romaji": "Shichi-ji ni okimasu.", "french": "Je me lève à 7 heures."},
        {"japanese": "月曜日に会います。", "romaji": "Getsuyōbi ni aimasu.", "french": "On se voit lundi."},
        {"japanese": "来年に日本に行きます。", "romaji": "Rainen ni Nihon ni ikimasu.", "french": "J'irai au Japon l'année prochaine."}
      ]
    },
    {
      "id": 6,
      "pattern": "〜で (lieu)",
      "category": "particules",
      "level": "N5",
      "explanation": "Indique le lieu où se déroule une action.",
      "structure": "[Nom de lieu] + で + [verbe d'action]",
      "examples": [
        {"japanese": "図書館で勉強します。", "romaji": "Toshokan de benkyō shimasu.", "french": "J'étudie à la bibliothèque."},
        {"japanese": "レストランで食べます。", "romaji": "Resutoran de tabemasu.", "french": "Je mange au restaurant."},
        {"japanese": "公園で遊びます。", "romaji": "Kōen de asobimasu.", "french": "Je joue au parc."}
      ]
    },
    {
      "id": 7,
      "pattern": "〜で (moyen)",
      "category": "particules",
      "level": "N5",
      "explanation": "Indique le moyen, l'outil ou la méthode utilisée.",
      "structure": "[Nom] + で + [verbe]",
      "examples": [
        {"japanese": "電車で行きます。", "romaji": "Densha de ikimasu.", "french": "J'y vais en train."},
        {"japanese": "日本語で話します。", "romaji": "Nihongo de hanashimasu.", "french": "Je parle en japonais."},
        {"japanese": "箸で食べます。", "romaji": "Hashi de tabemasu.", "french": "Je mange avec des baguettes."}
      ]
    },
    {
      "id": 8,
      "pattern": "〜と",
      "category": "particules",
      "level": "N5",
      "explanation": "Indique 'avec' (accompagnement) ou 'et' (énumération complète).",
      "structure": "[Nom] + と + [Nom/verbe]",
      "examples": [
        {"japanese": "友達と映画を見ます。", "romaji": "Tomodachi to eiga o mimasu.", "french": "Je regarde un film avec un ami."},
        {"japanese": "犬と猫がいます。", "romaji": "Inu to neko ga imasu.", "french": "Il y a un chien et un chat."},
        {"japanese": "父と母は医者です。", "romaji": "Chichi to haha wa isha desu.", "french": "Mon père et ma mère sont médecins."}
      ]
    },
    {
      "id": 9,
      "pattern": "〜の (possession)",
      "category": "particules",
      "level": "N5",
      "explanation": "Indique la possession ou l'appartenance.",
      "structure": "[Possesseur] + の + [Chose possédée]",
      "examples": [
        {"japanese": "私の本", "romaji": "Watashi no hon", "french": "Mon livre"},
        {"japanese": "先生の車", "romaji": "Sensei no kuruma", "french": "La voiture du professeur"},
        {"japanese": "日本の文化", "romaji": "Nihon no bunka", "french": "La culture du Japon"}
      ]
    },
    {
      "id": 10,
      "pattern": "〜の (nominalisation)",
      "category": "particules",
      "level": "N5",
      "explanation": "Transforme une phrase en nom (nominalisation).",
      "structure": "[Phrase verbale] + の + [verbe/です]",
      "examples": [
        {"japanese": "本を読むのが好きです。", "romaji": "Hon o yomu no ga suki desu.", "french": "J'aime lire des livres."},
        {"japanese": "日本語を勉強するのは楽しいです。", "romaji": "Nihongo o benkyō suru no wa tanoshii desu.", "french": "Étudier le japonais est amusant."},
        {"japanese": "泳ぐのは上手です。", "romaji": "Oyogu no wa jōzu desu.", "french": "Je suis bon en natation."}
      ]
    },
    {
      "id": 11,
      "pattern": "〜へ",
      "category": "particules",
      "level": "N5",
      "explanation": "Indique la direction du mouvement (similaire à に mais plus directionnel).",
      "structure": "[Lieu] + へ + [verbe de mouvement]",
      "examples": [
        {"japanese": "学校へ行きます。", "romaji": "Gakkō e ikimasu.", "french": "Je vais vers l'école."},
        {"japanese": "日本へ来ます。", "romaji": "Nihon e kimasu.", "french": "Je viens au Japon."},
        {"japanese": "家へ帰ります。", "romaji": "Ie e kaerimasu.", "french": "Je rentre à la maison."}
      ]
    },
    {
      "id": 12,
      "pattern": "〜か",
      "category": "particules",
      "level": "N5",
      "explanation": "Marque une question (forme polie).",
      "structure": "[Phrase] + か",
      "examples": [
        {"japanese": "学生ですか。", "romaji": "Gakusei desu ka.", "french": "Êtes-vous étudiant ?"},
        {"japanese": "これは何ですか。", "romaji": "Kore wa nan desu ka.", "french": "Qu'est-ce que c'est ?"},
        {"japanese": "どこに行きますか。", "romaji": "Doko ni ikimasu ka.", "french": "Où allez-vous ?"}
      ]
    },
    {
      "id": 13,
      "pattern": "〜も",
      "category": "particules",
      "level": "N5",
      "explanation": "Signifie 'aussi, également'.",
      "structure": "[Nom] + も + [verbe/adjectif]",
      "examples": [
        {"japanese": "私も学生です。", "romaji": "Watashi mo gakusei desu.", "french": "Moi aussi, je suis étudiant."},
        {"japanese": "これもいいです。", "romaji": "Kore mo ii desu.", "french": "Celui-ci aussi est bien."},
        {"japanese": "彼も来ます。", "romaji": "Kare mo kimasu.", "french": "Lui aussi viendra."}
      ]
    },
    {
      "id": 14,
      "pattern": "〜や",
      "category": "particules",
      "level": "N5",
      "explanation": "Liste non exhaustive d'exemples (et autres choses similaires).",
      "structure": "[Nom] + や + [Nom] + など",
      "examples": [
        {"japanese": "りんごやバナナを買いました。", "romaji": "Ringo ya banana o kaimashita.", "french": "J'ai acheté des pommes, des bananes, etc."},
        {"japanese": "本や雑誌があります。", "romaji": "Hon ya zasshi ga arimasu.", "french": "Il y a des livres, des magazines, etc."},
        {"japanese": "犬や猫が好きです。", "romaji": "Inu ya neko ga suki desu.", "french": "J'aime les chiens, les chats, etc."}
      ]
    },
    {
      "id": 15,
      "pattern": "〜から (origine)",
      "category": "particules",
      "level": "N5",
      "explanation": "Indique le point de départ (lieu ou temps).",
      "structure": "[Lieu/Temps] + から + [verbe]",
      "examples": [
        {"japanese": "九時から始まります。", "romaji": "Ku-ji kara hajimarimasu.", "french": "Ça commence à partir de 9 heures."},
        {"japanese": "東京から来ました。", "romaji": "Tōkyō kara kimashita.", "french": "Je viens de Tokyo."},
        {"japanese": "月曜日から金曜日まで働きます。", "romaji": "Getsuyōbi kara kin'yōbi made hatarakimasu.", "french": "Je travaille du lundi au vendredi."}
      ]
    },
    {
      "id": 16,
      "pattern": "〜から (raison)",
      "category": "particules",
      "level": "N5",
      "explanation": "Indique la raison ou la cause (parce que).",
      "structure": "[Raison] + から、[Conséquence]",
      "examples": [
        {"japanese": "雨が降りますから、傘を持って行きます。", "romaji": "Ame ga furimasu kara, kasa o motte ikimasu.", "french": "Parce qu'il pleut, j'emporte un parapluie."},
        {"japanese": "明日は試験ですから、今日は勉強します。", "romaji": "Ashita wa shiken desu kara, kyō wa benkyō shimasu.", "french": "Comme il y a un examen demain, j'étudie aujourd'hui."},
        {"japanese": "寒いですから、窓を閉めてください。", "romaji": "Samui desu kara, mado o shimete kudasai.", "french": "Parce qu'il fait froid, fermez la fenêtre s'il vous plaît."}
      ]
    },
    {
      "id": 17,
      "pattern": "〜まで",
      "category": "particules",
      "level": "N5",
      "explanation": "Indique le point final (jusqu'à).",
      "structure": "[Lieu/Temps] + まで + [verbe]",
      "examples": [
        {"japanese": "五時まで働きます。", "romaji": "Go-ji made hatarakimasu.", "french": "Je travaille jusqu'à 5 heures."},
        {"japanese": "駅まで歩きます。", "romaji": "Eki made arukimasu.", "french": "Je marche jusqu'à la gare."},
        {"japanese": "月曜日から金曜日まで学校があります。", "romaji": "Getsuyōbi kara kin'yōbi made gakkō ga arimasu.", "french": "Il y a école du lundi au vendredi."}
      ]
    },
    {
      "id": 18,
      "pattern": "〜ね",
      "category": "particules",
      "level": "N5",
      "explanation": "Demande confirmation ou accord (n'est-ce pas ?).",
      "structure": "[Phrase] + ね",
      "examples": [
        {"japanese": "いい天気ですね。", "romaji": "Ii tenki desu ne.", "french": "Il fait beau, n'est-ce pas ?"},
        {"japanese": "おいしいですね。", "romaji": "Oishii desu ne.", "french": "C'est délicieux, n'est-ce pas ?"},
        {"japanese": "明日は休みですね。", "romaji": "Ashita wa yasumi desu ne.", "french": "Demain c'est un jour de congé, n'est-ce pas ?"}
      ]
    },
    {
      "id": 19,
      "pattern": "〜よ",
      "category": "particules",
      "level": "N5",
      "explanation": "Insiste sur une information ou donne un conseil.",
      "structure": "[Phrase] + よ",
      "examples": [
        {"japanese": "もう遅いですよ。", "romaji": "Mō osoi desu yo.", "french": "Il est déjà tard !"},
        {"japanese": "これはおいしいですよ。", "romaji": "Kore wa oishii desu yo.", "french": "C'est délicieux, tu sais !"},
        {"japanese": "気をつけてくださいよ。", "romaji": "Ki o tsukete kudasai yo.", "french": "Faites attention, hein !"}
      ]
    },
    {
      "id": 20,
      "pattern": "ます形",
      "category": "verbes",
      "level": "N5",
      "explanation": "Forme polie affirmative présent/futur des verbes.",
      "structure": "[Radical] + ます",
      "examples": [
        {"japanese": "食べます", "romaji": "tabemasu", "french": "manger (forme polie)"},
        {"japanese": "行きます", "romaji": "ikimasu", "french": "aller (forme polie)"},
        {"japanese": "勉強します", "romaji": "benkyō shimasu", "french": "étudier (forme polie)"}
      ]
    },
    {
      "id": 21,
      "pattern": "ません",
      "category": "verbes",
      "level": "N5",
      "explanation": "Forme polie négative présent/futur des verbes.",
      "structure": "[Radical] + ません",
      "examples": [
        {"japanese": "食べません", "romaji": "tabemasen", "french": "ne pas manger"},
        {"japanese": "行きません", "romaji": "ikimasen", "french": "ne pas aller"},
        {"japanese": "飲みません", "romaji": "nomimasen", "french": "ne pas boire"}
      ]
    },
    {
      "id": 22,
      "pattern": "ました",
      "category": "verbes",
      "level": "N5",
      "explanation": "Forme polie affirmative passé des verbes.",
      "structure": "[Radical] + ました",
      "examples": [
        {"japanese": "食べました", "romaji": "tabemashita", "french": "j'ai mangé"},
        {"japanese": "行きました", "romaji": "ikimashita", "french": "je suis allé"},
        {"japanese": "見ました", "romaji": "mimashita", "french": "j'ai vu"}
      ]
    },
    {
      "id": 23,
      "pattern": "ませんでした",
      "category": "verbes",
      "level": "N5",
      "explanation": "Forme polie négative passé des verbes.",
      "structure": "[Radical] + ませんでした",
      "examples": [
        {"japanese": "食べませんでした", "romaji": "tabemasen deshita", "french": "je n'ai pas mangé"},
        {"japanese": "行きませんでした", "romaji": "ikimasen deshita", "french": "je ne suis pas allé"},
        {"japanese": "分かりませんでした", "romaji": "wakarimasen deshita", "french": "je n'ai pas compris"}
      ]
    },
    {
      "id": 24,
      "pattern": "〜てください",
      "category": "verbes",
      "level": "N5",
      "explanation": "Demande polie (s'il vous plaît faites...).",
      "structure": "[Verbe forme て] + ください",
      "examples": [
        {"japanese": "待ってください。", "romaji": "Matte kudasai.", "french": "Attendez s'il vous plaît."},
        {"japanese": "食べてください。", "romaji": "Tabete kudasai.", "french": "Mangez s'il vous plaît."},
        {"japanese": "ここに座ってください。", "romaji": "Koko ni suwatte kudasai.", "french": "Asseyez-vous ici s'il vous plaît."}
      ]
    },
    {
      "id": 25,
      "pattern": "〜ています",
      "category": "verbes",
      "level": "N5",
      "explanation": "Action en cours ou état résultant.",
      "structure": "[Verbe forme て] + います",
      "examples": [
        {"japanese": "今、勉強しています。", "romaji": "Ima, benkyō shite imasu.", "french": "Je suis en train d'étudier maintenant."},
        {"japanese": "東京に住んでいます。", "romaji": "Tōkyō ni sunde imasu.", "french": "J'habite à Tokyo."},
        {"japanese": "結婚しています。", "romaji": "Kekkon shite imasu.", "french": "Je suis marié(e)."}
      ]
    },
    {
      "id": 26,
